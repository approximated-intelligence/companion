<?xml version="1.0" encoding="utf-8"?>
<!--
    Every module's database (core.db, media.db, backup.db, posts.db,
    track.db, audio.db) and every DataStore travel with backups. Device-bound
    secrets (SecretStore files) never do — they cannot be decrypted elsewhere.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="backup_secrets.xml" />
        <exclude domain="sharedpref" path="posts_secrets.xml" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="backup_secrets.xml" />
        <exclude domain="sharedpref" path="posts_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
